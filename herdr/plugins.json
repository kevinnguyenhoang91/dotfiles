      "resolved_commit": "3ef126f68b443469f6d3c09248380ce18f70fd5b",
      "managed_path": "/Users/khanh9/.config/herdr/plugins/github/chmarax.herdr-nvim-178624809c23",
      "installed_unix_ms": 1790234980501
    }
  },
