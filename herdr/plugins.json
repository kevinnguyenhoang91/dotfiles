      "resolved_commit": "4b3b82d237a0d9c86aec70366219ce1c8807b0f7",
      "managed_path": "/Users/khanh9/.config/herdr/plugins/github/hhdebb.herdr-radar-afabda667cbe",
      "installed_unix_ms": 1790303687998
    }
