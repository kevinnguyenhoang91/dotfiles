{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tavily-mcp": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}"
    },
    "mcp-shell-server": {
      "type": "local",
      "command": ["uvx", "mcp-shell-server"],
      "enabled": true,
      "environment": {
        "ALLOW_COMMANDS": "ls,cat,pwd,grep,wc,touch,find,rm,echo,head,tail,chmod,chown,mkdir,rmdir,cp,mv,ln,ps,kill"
      }
    },
    "mcp-devcontainers": {
      "command": ["npx", "-y", "@crunchloop/mcp-devcontainers"],
      "enabled": false,
      "environment": {},
      "type": "local"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "github": {
      "type": "remote",
      "enabled": true,
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_PAT}"
      }
    },
    "memory": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"]
    },
    "mcp-compass": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@liuyoshio/mcp-compass"]
    },
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server"
      ]
    },
    "ddg-search": {
      "type": "local",
      "enabled": true,
      "command": ["uvx", "duckduckgo-mcp-server"]
    },
    "everything": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@modelcontextprotocol/server-everything"]
    },
    "mcp-server-fetch": {
      "type": "local",
      "enabled": true,
      "command": ["uvx", "mcp-server-fetch"]
    },
    "mcp-filesystem": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/tmp"
      ]
    },
    "mcp-server-git": {
      "type": "local",
      "enabled": true,
      "command": ["uvx", "mcp-server-git"]
    },
    "mcp-server-time": {
      "type": "local",
      "enabled": true,
      "command": ["uvx", "mcp-server-time"]
    },
    "mcp-package-registry-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "package-registry-mcp"]
    },
    "xcodebuild-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "xcodebuildmcp@latest"]
    }
  }
}
