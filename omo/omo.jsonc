// OMO configuration
{
  // Harness-agnostic routing. Applies to every harness including senpi/native
  // (which maps to "[native]"); the "[opencode]" block below is only read by
  // the opencode harness. Model specifiers must name a provider the registry
  // actually serves (here: openrouter), or omo refuses to bill them and
  // delegated agents fail with "No available model ... (attempted none)".
  "agents": {
    // Built-in omo subagents carry no model of their own, so they need one here.
    "explore": {
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "variant": "high",
    },
    "librarian": {
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "variant": "high",
    },
    "plan-consultant": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "variant": "xhigh",
    },
  },
  "categories": {
    "quick": {
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "variant": "high",
    },
    "unspecified-low": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "variant": "high",
    },
    "unspecified-high": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "variant": "xhigh",
    },
    "deep-low": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "variant": "high",
    },
    "deep-high": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "variant": "xhigh",
    },
    "ultrabrain": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "variant": "xhigh",
    },
    "architect": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "variant": "xhigh",
    },
    "artistry": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "variant": "xhigh",
    },
    "visual-engineering": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "variant": "high",
    },
    "writing": { "model": "openrouter/openai/gpt-5.6-luna", "variant": "high" },
  },
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
    "agents": {
      "sisyphus": {
        "model": "openrouter/anthropic/claude-opus-5",
        "variant": "max",
        "fallback_models": [
          {
            "model": "github-copilot/claude-opus-5",
            "variant": "max",
          },
          {
            "model": "openrouter/openai/gpt-5.6-sol",
            "variant": "medium",
          },
          {
            "model": "github-copilot/gpt-5.6-sol",
            "variant": "medium",
          },
        ],
      },
      "hephaestus": {
        "model": "openrouter/openai/gpt-5.6-sol",
        "variant": "medium",
        "fallback_models": [
          {
            "model": "github-copilot/gpt-5.6-sol",
            "variant": "medium",
          },
        ],
      },
      "oracle": {
        "model": "openrouter/openai/gpt-5.6-sol",
        "variant": "xhigh",
        "fallback_models": [
          {
            "model": "github-copilot/gpt-5.6-sol",
            "variant": "high",
          },
          {
            "model": "openrouter/google/gemini-3.1-pro-preview",
            "variant": "high",
          },
          {
            "model": "openrouter/anthropic/claude-opus-5",
            "variant": "max",
          },
          {
            "model": "github-copilot/claude-opus-5",
            "variant": "max",
          },
        ],
      },
      "librarian": {
        "model": "openrouter/openai/gpt-5.6-luna",
        "variant": "low",
        "fallback_models": [
          {
            "model": "openrouter/anthropic/claude-haiku-4.5",
          },
          {
            "model": "github-copilot/claude-haiku-4.5",
          },
          {
            "model": "openrouter/openai/gpt-5.4-nano",
          },
        ],
      },
      "explore": {
        "model": "openrouter/openai/gpt-5.6-luna",
        "variant": "low",
        "fallback_models": [
          {
            "model": "openrouter/anthropic/claude-haiku-4.5",
          },
          {
            "model": "github-copilot/claude-haiku-4.5",
          },
          {
            "model": "openrouter/openai/gpt-5.4-nano",
          },
        ],
      },
      "multimodal-looker": {
        "model": "openrouter/openai/gpt-5.6-sol",
        "variant": "low",
        "fallback_models": [
          {
            "model": "openrouter/openai/gpt-5-nano",
          },
        ],
      },
      "prometheus": {
        "model": "openrouter/anthropic/claude-fable-5",
        "variant": "high",
        "fallback_models": [
          {
            "model": "github-copilot/claude-fable-5",
            "variant": "high",
          },
        ],
      },
      "metis": {
        "model": "openrouter/anthropic/claude-opus-5",
        "variant": "high",
        "fallback_models": [
          {
            "model": "github-copilot/claude-opus-5",
            "variant": "high",
          },
        ],
      },
      "momus": {
        "model": "openrouter/openai/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": [
          {
            "model": "github-copilot/gpt-5.6-terra",
            "variant": "high",
          },
          {
            "model": "openrouter/openai/gpt-5.6-sol",
            "variant": "xhigh",
          },
          {
            "model": "github-copilot/gpt-5.6-sol",
            "variant": "high",
          },
          {
            "model": "openrouter/anthropic/claude-opus-5",
            "variant": "max",
          },
          {
            "model": "github-copilot/claude-opus-5",
            "variant": "max",
          },
          {
            "model": "openrouter/google/gemini-3.1-pro-preview",
            "variant": "high",
          },
        ],
      },
      "atlas": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "fallback_models": [
          {
            "model": "github-copilot/claude-sonnet-5",
          },
          {
            "model": "openrouter/openai/gpt-5.6-sol",
            "variant": "medium",
          },
          {
            "model": "github-copilot/gpt-5.6-sol",
            "variant": "medium",
          },
        ],
      },
      "sisyphus-junior": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "fallback_models": [
          {
            "model": "github-copilot/claude-sonnet-5",
