            "variant": "medium",
          },
          {
            "model": "github-copilot/gpt-5.6-sol",
            "variant": "medium",
          },
        ],
      },
    },
    "categories": {
      "visual-engineering": {
        "model": "openrouter/anthropic/claude-opus-5",
        "variant": "max",
        "fallback_models": [
          {
            "model": "github-copilot/claude-opus-5",
